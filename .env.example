# ==============================================================================
# VARIABLES DE ENTORNO (PLANTILLA)
# Copia este archivo como '.env' en la raíz y asigna tus credenciales reales:
#   copy .env.example .env
# ==============================================================================

# Entorno de ejecución (development / production / testing)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Conexión a Base de Datos MySQL (Almacenamiento analítico para Power BI)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_mysql_aqui
DB_NAME=memoria_historica

# ------------------------------------------------------------------------------
# API de Datos Abiertos de Colombia (datos.gov.co / Socrata SODA)
# ------------------------------------------------------------------------------
# El App Token es opcional pero altamente recomendado para evitar rate limiting (HTTP 429)
# Puedes generarlo gratuitamente registrándote en https://www.datos.gov.co/profile/edit/developer_settings
SODATA_APP_TOKEN=tu_token_socrata_aqui

# ------------------------------------------------------------------------------
# Configuración de Logging y Monitoreo
# ------------------------------------------------------------------------------
# Niveles posibles: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_DIR=logs

