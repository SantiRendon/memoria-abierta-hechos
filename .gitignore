# Entornos virtuales
venv/
.venv/
env/
ENV/

# Variables de entorno y secretos
.env
.env.local
.env.*.local

# Bytecode y cache de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebooks
.ipynb_checkpoints/
*-checkpoint.ipynb

# Datos crudos, procesados y de features (evitar subir datos masivos o sensibles)
hechos/*/data/raw/
hechos/*/data/raw/**
hechos/*/data/processed/
hechos/*/data/processed/**
hechos/*/data/features/
hechos/*/data/features/**
data/raw/
data/processed/
data/features/

# Extensiones de datos masivos
*.csv
*.parquet

# Excepciones: conservar estructura con .gitkeep si aplica
!hechos/**/.gitkeep
!hechos/**/data/**/.gitkeep
!**/.gitkeep

# Modelos entrenados y checkpoints
hechos/*/modelos/*.pkl
hechos/*/modelos/*.joblib
*.pkl
*.joblib

# Logs de ejecución
logs/*.log
*.log

# Configuraciones de IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

